<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown immediately while Flutter initializes -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <!-- Keep splash from auto-inverting in dark mode -->
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- Used after Flutter draws its first frame -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Force white to avoid black behind Flutter content -->
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- image_cropper / uCrop: keep toolbar above nav bar and match app UI -->
    <style name="UCropTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/ucrop_nav_bar</item>
        <item name="android:navigationBarColor">@color/ucrop_nav_bar</item>
        <item name="android:statusBarColor">@color/ucrop_status_bar</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
